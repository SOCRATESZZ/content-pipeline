# ─────────────────────────────────────────────────────────────────────────────
# Reddit API
# Obtain credentials at: https://www.reddit.com/prefs/apps
# ─────────────────────────────────────────────────────────────────────────────
REDDIT__CLIENT_ID=your_reddit_client_id
REDDIT__CLIENT_SECRET=your_reddit_client_secret
REDDIT__USER_AGENT=ContentPipeline/1.0

# ─────────────────────────────────────────────────────────────────────────────
# Twitter / X API v2
# Obtain bearer token at: https://developer.twitter.com/en/portal/dashboard
# ─────────────────────────────────────────────────────────────────────────────
TWITTER__BEARER_TOKEN=your_twitter_bearer_token

# ─────────────────────────────────────────────────────────────────────────────
# Anthropic (Claude)
# Obtain API key at: https://console.anthropic.com/
# ─────────────────────────────────────────────────────────────────────────────
ANTHROPIC__API_KEY=your_anthropic_api_key
ANTHROPIC__MODEL=claude-sonnet-4-20250514
ANTHROPIC__MAX_TOKENS=1000

# ─────────────────────────────────────────────────────────────────────────────
# ElevenLabs (Text-to-Speech)
# Obtain API key at: https://elevenlabs.io/app/settings/api
# Find voice IDs at: https://api.elevenlabs.io/v1/voices
# ─────────────────────────────────────────────────────────────────────────────
ELEVENLABS__API_KEY=your_elevenlabs_api_key
ELEVENLABS__VOICE_ID=your_voice_id
ELEVENLABS__MODEL_ID=eleven_turbo_v2

# ─────────────────────────────────────────────────────────────────────────────
# HeyGen (AI Avatar Video)
# Obtain API key at: https://app.heygen.com/settings?nav=API
# Find avatar IDs in HeyGen studio
# ─────────────────────────────────────────────────────────────────────────────
HEYGEN__API_KEY=your_heygen_api_key
HEYGEN__AVATAR_ID=your_avatar_id
HEYGEN__POLL_INTERVAL_SECONDS=10
HEYGEN__POLL_TIMEOUT_SECONDS=300

# ─────────────────────────────────────────────────────────────────────────────
# Instagram Graph API v18
# Obtain access token and user ID at: https://developers.facebook.com/
# ─────────────────────────────────────────────────────────────────────────────
INSTAGRAM__ACCESS_TOKEN=your_instagram_access_token
INSTAGRAM__USER_ID=your_instagram_user_id

# ─────────────────────────────────────────────────────────────────────────────
# YouTube Data API v3
# Download OAuth credentials JSON from: https://console.cloud.google.com/
# ─────────────────────────────────────────────────────────────────────────────
YOUTUBE__CREDENTIALS_JSON_PATH=/path/to/youtube_credentials.json

# ─────────────────────────────────────────────────────────────────────────────
# AWS S3 (media storage)
# Configure via: https://console.aws.amazon.com/iam/
# ─────────────────────────────────────────────────────────────────────────────
AWS__BUCKET_NAME=your_s3_bucket_name
AWS__REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# ─────────────────────────────────────────────────────────────────────────────
# Ayrshare (scheduled publishing — optional)
# Obtain API key at: https://www.ayrshare.com/
# ─────────────────────────────────────────────────────────────────────────────
AYRSHARE__API_KEY=your_ayrshare_api_key
